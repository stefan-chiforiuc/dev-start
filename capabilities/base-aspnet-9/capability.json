{
  "$schema": "https://dev-start.dev/schemas/capability/1.json",
  "name": "base-aspnet-9",
  "version": "0.1.0",
  "description": "ASP.NET Core 9 API foundation. Same layered shape as `base`, targeting .NET 9.",
  "family": "backend",
  "framework": "aspnet",
  "frameworkVersion": "9",
  "provides": ["base"],
  "extends": "_shared/backend-aspnet",
  "stacks": ["dotnet-api"],
  "dependsOn": [],
  "conflictsWith": ["base"],
  "addsServices": [],
  "envAdditions": [
    { "key": "ASPNETCORE_URLS", "example": "http://+:5000" },
    { "key": "ASPNETCORE_ENVIRONMENT", "example": "Development" }
  ],
  "postInstall": [
    "dotnet restore",
    "dotnet build -c Debug"
  ],
  "doctor": [
    { "check": "dotnet-version", "min": "9.0" },
    { "check": "file", "path": "src/{{Name}}.Api/Program.cs" }
  ]
}
